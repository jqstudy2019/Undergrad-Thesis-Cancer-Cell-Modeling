###############################################################################################################################
variable     			scale1 equal ramp(2.7,2.52)                                      # Sets the scale performed in the final fix on water scaling down sigma from 2.7- 2.5
units					lj
atom_style				sphere
###			#atom_modify			map array first membrane
dimension				3

fix             		molprop all property/atom mol
read_data				deformMemV1.data fix molprop NULL Molecules

set						type 1 mass 1.0
group					membrane type 1
velocity				membrane create 14.4 87287 loop geom

pair_style				hybrid lj/cut 3.6 fluidmembrane 2.6
pair_coeff				1 1 lj/cut .2 1


###			pair_coeff			2 2 0.0 0.0
###			pair_coeff			1 2 0.0 0.0

###			#variable        		prefactor equal ramp(0,60)
###			#fix             		soft all adapt 1 pair soft a * * v_prefactor

	
neighbor				1.0 bin


###			#neigh_modify			delay 0 every 1 check yes

###			#fix					1 membrane rigid molecule


dump					1 all atom 10 dump.deformMemV1.inital
undump					1


###			#compute				tmembrane all temp/sphere
###			#thermo_modify			temp tmembrane


thermo_style			custom step temp press ebond
thermo					100
timestep				.005


# equilibrium

fix         			1 membrane nvt/asphere temp .23 .23 1.0
dump					1 all atom 10 dump.deformMemV1.inital
run						10000


# change RBC volume

fix         			2 water adapt 1 pair lj/cut sigma  6 6 v_scale1 
dump					1 all atom 10 dump.deformMemV1.inital
run						40000
unfix 					2
run						20000















