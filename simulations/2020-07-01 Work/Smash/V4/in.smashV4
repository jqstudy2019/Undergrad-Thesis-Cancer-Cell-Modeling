##############################################################################################################################
# in.smashV4 - This is an input file for a doing scince the easy way, smashing things toghether and seeing what happens
#
# By: John Quinn
#
# Date: 7/1/2020
#
# Summary of Code: (General Steps of code)
#
#
# Apendix of Commands:
#	(Command -> commands function ; format( Command arg1 arg 2 . . .) ; more notes)
#		
# Changes from in.smashV1
#			Membranes Collide (hopefully)
#			Changed the atom style to iron out bugs
#
#
###############################################################################################################################

units				lj
atom_style			hybrid sphere bond
dimension			3
boundary 			p p p

read_data			smashV4.data 

group				Center type 1
group				Bullet type 2

neighbor			0.3 bin
neigh_modify		delay 0 every 1 check yes

velocity			Bullet set 0 0 -1
velocity			Center set 0 0 10

create_bonds		Center Center harmonic 1.0 1.2
create_bonds		Bullet Bullet harmonic 1.0 1.2
bond_style			harmonic 
bond_coeff			1 0.0028125 2

pair_style			morse 3
pair_coeff 			* * 1e-3 1 2.0 2.0

neighbor			0.3 bin
neigh_modify		delay 0 every 1 check yes

pair_style			lj/cut 2.5
pair_coeff			1 1 1.0 1.0

timestep			0.001
thermo				1000
dump 				1 all atom 50 dump.smashV1

fix            		1 all nvt/asphere temp 0.23 0.23 1.0      # Applies an NVT (not NPT) ensemble fix to the network group using only temperature parameters

run					10000