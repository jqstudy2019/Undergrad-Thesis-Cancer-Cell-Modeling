# ------------------------ INITIALIZATION ----------------------------
units        metal														# units type (needs to agrees with data files, potential files + etc called in this script)
boundary     p p p														# Boundary type X , Y , Z planes (in this case periodic for all 3, periodic means all atoms crossing boundary will reappear on the opposite boundary) 
atom_style   atomic														# Sets up type of atoms for sim; sets various attributes

# ----------------------- ATOM DEFINITION ----------------------------
lattice hcp 3.20														# Defines lattice for other commands to use (set of points in space; determiend by unit cell of atoms duplicated; can be used with create_atoms to make atoms on lattice points; the unit cell of atoms can be used as its own relative units based on the cell)
region whole block 0  100 0 100 0 100 units box							# Defines a region in space, then other commands may use this region such as create_atoms, group, or delete_atoms
create_box 1 whole														# Creates Sim Box; region command must be run first to define the domain
region LLF cylinder z  50 50 20  INF INF  units box						# (Duplicate) 
lattice hcp 3.20 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1			# (Duplicate) 
create_atoms 1 region LLF												# creates atoms/molecules; either on a lattice, as a single atom or random collection of atoms; sim box must already exist 
#delete_atoms overlap 0.5 all all										# Delete the specified atoms. This command can be used to carve out voids from a block of material or to delete created atoms that are too close to each other (e.g. at a grain boundary).

# ------------------------ FORCE FIELDS ------------------------------
pair_style   eam/fs														# Sets the types of pairwise interactions (bonds) used by lammps during simulation
pair_coeff   * * Al-Mg.eam.fs Mg										# Specifies pairwise force field coefficients; style depends on number of atoms and type of pair/bond type 

# ------------------------- SETTINGS ---------------------------------
#### Computes Required							
compute csym all centro/atom 12											# Defines a computation to be performed on a group of atoms
compute 2 all stress/atom NULL pair bond								# Values calculated by computes are instantaneous values meaning are calculated on a single time step 
compute mytemp all temp													# Computes do not store values on their own 
compute 11 all reduce sum c_2[1]										# (Duplicate) 
compute 12 all reduce sum c_2[2]										# (Duplicate) 
compute 13 all reduce sum c_2[3]										# (Duplicate) 
compute 14 all reduce sum c_2[4]										# (Duplicate) 
compute 15 all reduce sum c_2[5]										# (Duplicate) 
compute 16 all reduce sum c_2[6]										# (Duplicate) 

neighbor     0.3 bin													# Defines which atoms are "neighbors" with each other; affects the behavior of the pairwise interactions (bonds)
neigh_modify delay 10													# affects the frequency of how often neighbor lists are generated 
thermo 100																# Computes and Prints thermodyanmic info
velocity all create 100.0 16723											# Set or change velocity of atom or group of atoms in one or several styles
thermo_style custom step temp etotal press pxx pyy pzz lx ly lz			# Sets style and content for thermo prints
shell mkdir dump														# Executes commands within the shell (Ubuntu)
shell cd dump															# (Duplicate) 

#---------------Energy Equilibriation--------------------------
reset_timestep 0														# Sets the time step value to desired ( done here b/c kinda multiple simualtions) 
fix 1 all nve															# Sets a "fix' that will be applies to a group of atoms during time stepping or minimization 
fix 2 all temp/rescale 10 100.0 100.0 1.0 0.5							# EX. Updating atom positions; applying constraint forces 
dump 1 all custom 10000 dump.equilibrate.* id type x y z 				# There are 100's of fix styles 

run 10000																# Runs or continues simulation for number of time steps specified
unfix 1																	# Deletes previously used fix
unfix 2																	# (Duplicate) 

#-----------------Pressure Equilibriation-----------------------
fix 1 all npt temp 100.0 100.0 10.0 aniso 0.0 0.0 10.0 drag 0.3			# (Duplicate) 
run 10000																# (Duplicate) 
unfix 1																	# (Duplicate) 
undump 1																# turns off previous dump and closes associated file
shell cd ..																# (Duplicate) 
shell mkdir deform														# (Duplicate) 
shell cd deform															# (Duplicate) 

#--------------------Storing Initial length---------------------
variable tmp equal "lz"													# Assigns one or more strings to a variable name for evaluation later  
variable L0 equal ${tmp}												# Helpful because can be referenced later to use the values later
print "Initial Length, L0: ${L0}"										# Print a text string to the screen and logfile. The text string must be a single argument, so if it is one line but more than one word, it should be enclosed in single or double quotes
variable strain equal "v_srate/1e12"									# (Duplicate)

#------------Deform------------------------------
reset_timestep 0														# (Duplicate)
fix 1 all deform 1 z erate 0.0001 units box								# (Duplicate)
fix 2 all nvt temp 100.0 100.0 10.0										# (Duplicate)

variable strain equal "(lz - v_L0)/v_L0"								# (Duplicate)
variable p1 equal "v_strain"											# (Duplicate)
variable p2 equal "-pxx/10000"											# (Duplicate)
variable p3 equal "-pyy/10000"											# (Duplicate)
variable p4 equal "-pzz/10000"											# (Duplicate)
variable p5 equal "lx"													# (Duplicate)
variable p6 equal "ly"													# (Duplicate)
variable p7 equal "lz"													# (Duplicate)
variable p8 equal "temp"												# (Duplicate)
variable p9 equal "pe"													# (Duplicate)									
variable p10 equal "ke"													# (Duplicate)
variable p11 equal "-pxy/10000"											# (Duplicate)
variable p13 equal "-pyz/10000"											# (Duplicate)
variable p12 equal "-pxz/10000"											# (Duplicate)
variable fm equal "(v_p2+v_p3+v_p4)/3" ##### Hydrostatic stress			# (Duplicate)

variable fv equal "sqrt((v_p2-v_p3)^2+(v_p3-v_p4)^2+(v_p4-v_p2)^2+6*(v_p11^2+v_p12^2+v_p13^2)/2)" ######Von Mises Stress

variable t equal "v_fm/v_fv"											#(Duplicate)
variable fd equal (((v_p2-v_fm)*(v_p3-v_fm)*(v_p4-v_fm))-v_p11^2*(v_p4-v_fm)-v_p12^2*(v_p3-v_fm)-v_p13^2*(v_p2-v_fm)+2*v_p11*v_p12*v_p13)####Deviatoric Von Mises stress

dump 2 all custom 10000 dump.defo.* id type x y z c_csym c_2[1] c_2[2] c_2[3] c_2[4] c_2[5] c_2[6]

fix def_print all print 100 "${p1} ${p2} ${p3} ${p4} ${p5} ${p6} ${p7} ${p8} ${p9} ${p10} ${p11} ${p12} ${p13} ${fm} ${fv} ${t} ${fd}" file mg001.defo.txt screen no #
run 100000																#(Duplicate)
