##############################################################################################################################
# in.SimpV2 - This is an input file for a membrne just kinda stiting there (hopefully looking pretty)

# By: John Quinn
#
# Date: 7/8/2020
#
# Changes From [ V1 ]
#	#Bonds! (hopefully works and keeps membrnae froms collapeing)
#		
###############################################################################################################################

units				lj

atom_style			molecular

dimension			3

boundary 			p p p

read_data			SimpV2.data 

group				Center type 1

neighbor			0.3 bin
neigh_modify		delay 0 every 1 check yes

mass				* 1.0

#velocity			Center set 0 0 10

bond_style			harmonic 
bond_coeff			1 8.0 1.2

pair_style 			lj/cut 2.5
pair_coeff 			* * 1 1

timestep			0.001

thermo				1000

dump 				1 all atom 50 dump.SimpV3

fix 				1 all nve

run					100000