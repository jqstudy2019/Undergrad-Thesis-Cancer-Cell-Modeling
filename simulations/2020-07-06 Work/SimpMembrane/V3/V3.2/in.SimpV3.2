###############################################################################################################################

units				lj

atom_style			molecular

dimension			3

boundary 			f f f

read_data			SimpV2.data 

group				Center type 1

neighbor			0.3 bin
neigh_modify		delay 0 every 1 check yes

mass				* 1.0

#velocity			Center set 0 0 10

bond_style			harmonic 
bond_coeff			1 20.0 2

pair_style 			lj/cut 3.6
pair_coeff 			* * 0.2 1.0

timestep			0.0001

thermo				1000

dump 				1 all atom 1 dump.SimpV3.2

fix 				1 all nve

run					100000