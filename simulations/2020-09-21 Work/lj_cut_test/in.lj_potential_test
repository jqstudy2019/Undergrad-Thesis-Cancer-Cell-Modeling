units				lj

atom_style			molecular

dimension			3

boundary 			p p p

read_data			Membrane_W_Water.data

group				Center type 1

neighbor			1.0 bin
neigh_modify		delay 0 every 1 check yes

mass				* 1.0

bond_style			harmonic 
bond_coeff			1 50 1.2
bond_coeff			2 50 2.4

pair_style 			lj/cut 2.5

pair_coeff 			1 1 1 1

pair_coeff 			1 2 .1 1

pair_coeff 			1 3 .1 1

pair_coeff 			2 3 1 1

pair_coeff 			2 2 1 1

pair_coeff 			3 3 1 1


timestep			0.00001

thermo				1000

dump 				1 all atom 500 dump.lj_cut_test_v3_TIMESTEP:100K

fix 				1 all nve

run					1000000