##############################################################################################################################
# in.Potential_Test_TEMPLATE
#
# By: John Quinn
#
# Date: 9/21/2020
#
###############################################################################################################################

units				lj

atom_style			molecular

dimension			3

boundary 			p p p

read_data			Membrane_W_Water.data

group				bilayer type 1
group				water type 2

neighbor			1.0 bin
neigh_modify		delay 0 every 1 check yes

comm_modify cutoff 5.0

mass				* 1.0

bond_style			harmonic 
bond_coeff			1 50 1.2
bond_coeff			2 50 2.4

pair_style 			lj/cut 2.5

pair_coeff 			1 1 1 1

pair_coeff 			1 2 .1 1

pair_coeff 			1 3 .1 1

pair_coeff 			2 3 1 1

pair_coeff 			2 2 1 1

pair_coeff 			3 3 1 1


timestep			0.00001

thermo				1000

dump 				1 all atom 500 dump.jq_test_V2

fix 				1 all nve

variable ini_T equal 0.02
variable T equal 0.23
variable P equal 0.05
variable LD equal 1.0
variable P_damp equal 1

fix 2 water npt temp 300.0 300.0 100.0 iso 0.0 0.0 1000.0

fix 3 bilayer nvt temp ${T} ${T} ${LD}


run					1000000