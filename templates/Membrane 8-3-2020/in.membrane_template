units				lj

atom_style			molecular

dimension			3

boundary 			p p p

read_data			Membrane_Template.data

group				Center type 1

neighbor			0.3 bin
neigh_modify		delay 0 every 1 check yes

mass				* 1.0

bond_style			harmonic 
bond_coeff			1 8 1.2

pair_style 			lj/cut 2.5
pair_coeff 			* * 1 1

timestep			0.001

thermo				1000

dump 				1 all atom 50 dump.Membrane_Template

fix 				1 all nve

run					100000